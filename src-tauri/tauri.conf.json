{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "twitchtrack",
  "version": "0.2.0",
  "identifier": "com.twitchtrack.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TwitchTrack",
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyRTRDOEEwQkVGMEY0NkMKUldSczlQQytvTWprRWhyZ2h2Lzd0UFhrczE4Y0RLOVV3cU5ZRmJvWTZ3Q2ROZ0NlcVBtN2xLbEcK",
      "endpoints": [
        "https://github.com/ChristopherK95/twitch-tracker/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
